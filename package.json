{
  "name": "academix",
  "version": "1.0.0",
  "private": true,
  "description": "Gestão acadêmica full stack para o desafio Codgo.X",
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "frontend:dev": "vite --config frontend/vite.config.js",
    "test": "node --test server/tests/**/*.test.js",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.9"
  }
}
